{
  "name": "deadnet",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/icons.mjs && vite",
    "build": "node scripts/icons.mjs && vite build",
    "preview": "npm run build && vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc -p worker/tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply deadnet --local",
    "db:migrate:remote": "wrangler d1 migrations apply deadnet --remote",
    "cf-typegen": "wrangler types worker/worker-configuration.d.ts",
    "deploy": "npm run build && wrangler deploy",
    "icons": "node scripts/icons.mjs",
    "db:seed:local": "wrangler d1 execute deadnet --local --file=drizzle/seed.sql"
  },
  "dependencies": {
    "@iconify/svelte": "^5.2.3",
    "@tanstack/svelte-query": "^6.3.6",
    "drizzle-orm": "^0.45.4",
    "svelte-dnd-action": "^0.9.80",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.66.0",
    "@cloudflare/vitest-plugin": "^1.4.11",
    "@iconify-json/tabler": "^1.2.43",
    "@iconify/utils": "^3.1.7",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/svelte": "^5.0.8",
    "drizzle-kit": "^0.31.11",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.0",
    "wrangler": "^4.156.0"
  }
}
