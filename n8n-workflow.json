        "jsonBody": "={\n  \"type\": \"complete\",\n  \"simulationId\": \"{{ $('Initialize Variables').item.json.simulationId }}\",\n  \"totalRounds\": {{ $('Initialize Variables').item.json.currentRound }},\n  \"timestamp\": \"{{ new Date().toISOString() }}\"\n}",
