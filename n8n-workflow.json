      "webhookId": "737ed682-c67f-4773-a577-ccbb1a7d39e4"
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "simulationId",
              "value": "={{ $json.simulationId }}"
            },
            {
