              "value": "={{ $json.poster.name }}"
            },
            {
              "name": "posterContent",
              "value": "={{ $json.poster.content }}"
            },
            {
              "name": "frontendWebhookUrl",
              "value": "={{ $json.frontendWebhookUrl || 'http://localhost:3000/api/simulation-updates' }}"
            },
            {
              "name": "conversationHistory",
              "value": ""
            },
            {
              "name": "currentRound",
              "value": "1"
            },
            {
              "name": "maxRounds",
              "value": "={{ $json.settings?.rounds || 3 }}"
            },
            {
              "name": "typingDelay",
              "value": "={{ $json.settings?.typingDelayMs || 3000 }}"
            }
          ],
          "array": [
            {
              "name": "selectedPersonas",
              "value": "={{ $json.selectedPersonas }}"
            },
            {
              "name": "personaNames",
              "value": "={{ $json.selectedPersonas.map(p => ({ fullName: p.name, nickname: p.name.split(' ')[0].replace('\"', '').replace('\"', '') })) }}"
            }
          ]
        },
        "options": {}
      },
      "id": "initialize-variables",
      "name": "Initialize Variables",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [460, 300]
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "split-personas",
      "name": "Split Personas",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [680, 300]
    },
    {
      "parameters": {
        "url": "={{ $('Initialize Variables').item.json.frontendWebhookUrl }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"type\": \"typing\",\n  \"simulationId\": \"{{ $('Initialize Variables').item.json.simulationId }}\",\n  \"persona\": {\n    \"id\": \"{{ $json.id }}\",\n    \"name\": \"{{ $json.name }}\",\n    \"picture\": \"{{ $json.picture }}\"\n  },\n  \"message\": \"is typing...\",\n  \"timestamp\": \"{{ new Date().toISOString() }}\",\n  \"round\": {{ $('Initialize Variables').item.json.currentRound }}\n}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "send-typing-indicator",
      "name": "Send Typing Indicator",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 300],
      "continueOnFail": true
    },
    {
      "parameters": {
        "amount": "={{ $('Initialize Variables').item.json.typingDelay }}",
        "unit": "ms"
      },
      "id": "typing-delay",
      "name": "Typing Delay",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [1120, 300]
    },
    {
      "parameters": {
        "resource": "text",
        "operation": "message",
        "model": "gpt-4o-mini",
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "={{ $json.systemPrompt }}"
            },
            {
              "role": "user", 
              "content": "=CONVERSATION CONTEXT:\nOriginal Post: {{ $('Initialize Variables').item.json.posterName }} posted: \"{{ $('Initialize Variables').item.json.posterContent }}\"\n\n{{ $('Initialize Variables').item.json.conversationHistory ? 'Previous Comments:\\n' + $('Initialize Variables').item.json.conversationHistory : 'No previous comments yet.' }}\n\nINSTRUCTIONS:\n- Respond as {{ $json.name }} with a heated but realistic social media comment\n- Keep response to 1-3 sentences (social media style)\n- Naturally mention other users by their first names when disagreeing (e.g., \"Kat is wrong\" or \"I disagree with Ben\")\n- Show your political stance clearly based on your persona\n- Be passionate but not abusive\n- Use Filipino-English code-switching naturally if appropriate\n- Reference previous comments when relevant\n- Make it feel like a real Facebook comment\n\nGenerate your response now:"
            }
          ]
        },
        "options": {
          "temperature": 0.8,
          "maxTokens": 150
        }
      },
      "id": "generate-ai-comment",
      "name": "Generate AI Comment",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1.4,
      "position": [1340, 300]
    },
    {
      "parameters": {
        "jsCode": "// Process mentions in the AI-generated comment\nconst comment = $input.first().json.choices[0].message.content;\nconst personaNames = $('Initialize Variables').item.json.personaNames;\nconst currentPersona = $('Split Personas').item.json;\n\n// Create mention mapping\nconst mentionMap = {};\npersonaNames.forEach(p => {\n  mentionMap[p.nickname.toLowerCase()] = p.fullName;\n});\n\n// Process mentions\nlet processedComment = comment;\nlet mentions = [];\n\n// Find mentions by nickname\nObject.keys(mentionMap).forEach(nickname => {\n  const regex = new RegExp(`\\\\b${nickname}\\\\b`, 'gi');\n  const matches = [...comment.matchAll(regex)];\n  \n  matches.forEach(match => {\n    const fullName = mentionMap[nickname.toLowerCase()];\n    mentions.push({\n      name: fullName,\n      nickname: nickname,\n      position: match.index\n    });\n    \n    // Replace with formatted mention\n    processedComment = processedComment.replace(\n      match[0], \n      `**@${fullName}**`\n    );\n  });\n});\n\n// Build conversation history entry\nconst historyEntry = `${currentPersona.name}: ${comment}`;\n\nreturn {\n  json: {\n    persona: currentPersona,\n    rawComment: comment,\n    processedComment: processedComment,\n    mentions: mentions,\n    historyEntry: historyEntry,\n    timestamp: new Date().toISOString()\n  }\n};"
      },
      "id": "process-mentions",
      "name": "Process Mentions",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1560, 300]
    },
    {
      "parameters": {
        "url": "={{ $('Initialize Variables').item.json.frontendWebhookUrl }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"type\": \"comment\",\n  \"simulationId\": \"{{ $('Initialize Variables').item.json.simulationId }}\",\n  \"persona\": {\n    \"id\": \"{{ $json.persona.id }}\",\n    \"name\": \"{{ $json.persona.name }}\",\n    \"picture\": \"{{ $json.persona.picture }}\"\n  },\n  \"content\": \"{{ $json.processedComment }}\",\n  \"rawContent\": \"{{ $json.rawComment }}\",\n  \"mentions\": {{ JSON.stringify($json.mentions) }},\n  \"timestamp\": \"{{ $json.timestamp }}\",\n  \"round\": {{ $('Initialize Variables').item.json.currentRound }}\n}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "send-comment-response",
      "name": "Send Comment Response",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1780, 300],
      "continueOnFail": true
    },
    {
