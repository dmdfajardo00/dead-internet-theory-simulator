        "values": {
          "string": [
            {
              "name": "conversationHistory",
              "value": "={{ $('Initialize Variables').item.json.conversationHistory ? $('Initialize Variables').item.json.conversationHistory + '\\n' + $json.historyEntry : $json.historyEntry }}"
            }
          ]
        },
        "options": {}
      },
      "id": "update-conversation-history",
      "name": "Update Conversation History",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [2000, 300]
